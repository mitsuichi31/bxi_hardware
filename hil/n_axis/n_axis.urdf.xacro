<?xml version="1.0"?>
<robot name="bxi_n_axis" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="axes" default="3"/>
  <xacro:arg name="config_file" default=""/>
  <xacro:arg name="spec_dir" default=""/>
  <xacro:property name="n" value="${int('$(arg axes)')}"/>
  <link name="base_link"/>
  <xacro:macro name="physical_joint" params="i">
    <link name="output${i}"/>
    <joint name="joint${i}" type="revolute">
      <parent link="base_link"/><child link="output${i}"/><axis xyz="0 0 1"/>
      <limit lower="-${pi/6}" upper="${pi/6}" effort="5" velocity="0.70"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="control_joint" params="i">
    <joint name="joint${i}">
      <command_interface name="position"/><command_interface name="velocity"/>
      <command_interface name="kp"/><command_interface name="kd"/><command_interface name="effort"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="effort"/><state_interface name="temperature"/>
    </joint>
  </xacro:macro>
  <xacro:physical_joint i="1"/><xacro:physical_joint i="2"/>
  <xacro:if value="${n == 3}"><xacro:physical_joint i="3"/></xacro:if>
  <ros2_control name="BxiNAxis" type="system">
    <hardware>
      <plugin>bxi_hardware/BxiSystemInterface</plugin>
      <param name="config_file">$(arg config_file)</param>
      <param name="spec_dir">$(arg spec_dir)</param>
      <param name="command_commit_mode">pair_generation_v1</param>
    </hardware>
    <xacro:control_joint i="1"/><xacro:control_joint i="2"/>
    <xacro:if value="${n == 3}"><xacro:control_joint i="3"/></xacro:if>
    <gpio name="bxi_pair">
      <command_interface name="commit_generation" data_type="double"/>
      <state_interface name="accepted_generation" data_type="double"/>
    </gpio>
  </ros2_control>
</robot>
