<?xml version="1.0"?>
<!-- 2軸準備用。物理接続・実機動作は別承認。 -->
<robot name="bxi_two_joint" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="joint_lower" default="-1.65"/>
  <xacro:arg name="joint_upper" default="1.65"/>
  <xacro:arg name="config_file" default=""/>
  <xacro:arg name="spec_dir" default=""/>
  <xacro:arg name="hardware_plugin" default="bxi_hardware/BxiSystemInterface"/>

  <link name="base_link"/>
  <link name="output_link"/>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="output_link"/>
    <axis xyz="0 0 1"/>
    <!-- 実際の範囲は bxi_hardware.yaml の lower / upper でクランプする -->
    <limit lower="$(arg joint_lower)" upper="$(arg joint_upper)" effort="50.0" velocity="10.0"/>
  </joint>

  <link name="output2_link"/>
  <joint name="joint2" type="revolute">
    <parent link="base_link"/><child link="output2_link"/><axis xyz="0 0 1"/>
    <limit lower="-1.65" upper="1.65" effort="50.0" velocity="10.0"/>
  </joint>

  <ros2_control name="BxiTwoJoint" type="system">
    <hardware>
      <plugin>$(arg hardware_plugin)</plugin>
      <param name="config_file">$(arg config_file)</param>
      <param name="spec_dir">$(arg spec_dir)</param>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
  </ros2_control>
</robot>
