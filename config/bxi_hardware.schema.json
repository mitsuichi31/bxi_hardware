{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BXI machine-independent hardware configuration",
  "type": "object",
  "required": ["active_can_buses", "defaults", "joints"],
  "additionalProperties": false,
  "properties": {
    "active_can_buses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "can_frame_format": {
      "type": "object",
      "additionalProperties": {"type": "string", "enum": ["classic", "fd", "fd_brs"]}
    },
    "can_transport": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/transport"}
    },
    "defaults": {
      "type": "object",
      "required": ["control_timeout_ms", "maximum_consecutive_timeouts", "can_hz"],
      "additionalProperties": true,
      "properties": {
        "control_timeout_ms": {"type": "integer", "minimum": 1},
        "maximum_consecutive_timeouts": {"type": "integer", "minimum": 1},
        "can_hz": {"type": "integer", "minimum": 1},
        "temperature_sensor_fault_below_c": {"type": "number"}
      }
    },
    "joints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/joint"}
    }
  },
  "$defs": {
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rx_mode": {"type": "string", "enum": ["sequential", "separate"]},
        "tx_trigger": {"type": "string", "enum": ["periodic", "write"]},
        "direct_feedback": {"type": "boolean"},
        "stream_write_grace_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
        "stream_first_write_timeout_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "tx_frame": {"type": "string", "enum": ["unicast", "broadcast"]},
        "stream_feedback_max_age_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
        "stream_command_max_age_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
        "hil_isolated_id1_broadcast_blocks": {"type": "integer", "const": 3},
        "send_thread_priority": {"type": "integer", "minimum": 1, "maximum": 98},
        "receive_thread_priority": {"type": "integer", "minimum": 1, "maximum": 98},
        "thread_cpus": {
          "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 1023}
        }
      }
    },
    "joint": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": true,
      "properties": {
        "enabled": {"type": "boolean"},
        "can_bus": {"type": "string"},
        "can_id": {"type": "integer", "minimum": 1, "maximum": 15},
        "motor_dir": {"type": "integer", "enum": [-1, 1]},
        "motor_type": {"type": "string", "minLength": 1},
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "default_kp": {"type": "number", "minimum": 0},
        "default_kd": {"type": "number", "minimum": 0}
      }
    }
  }
}
